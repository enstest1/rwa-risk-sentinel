# Public/runtime configuration
PUBLIC_BASE_URL=https://rwa-risk-sentinel.up.railway.app
BRIEF_HOUR_UTC=15

# Internal watcher authentication
INTERNAL_TOKEN=

# Email delivery (required for live email MVP)
RESEND_API_KEY=
EMAIL_FROM=

# Optional research enrichment — neither is required for risk scoring
OPENROUTER_API_KEY=
OPENROUTER_MODEL=perplexity/sonar-pro
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Hero animation
HERO_VIDEO_URL=/assets/sentinel-hero-loop.mp4

# Railway object storage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
